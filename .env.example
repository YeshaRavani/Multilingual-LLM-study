# Translation
GOOGLE_TRANSLATE_API_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini generateContent API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Temporary free pilot: GPT-OSS through Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# Temporary free pilot: Meta Llama through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA Build free trial endpoint
NVIDIA_API_KEY=PASTE_NVIDIA_API_KEY_HERE
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Llama provider. Use any OpenAI-compatible endpoint, such as Together or Groq.
LLAMA_API_KEY=
LLAMA_MODEL=
LLAMA_BASE_URL=

# Experiment controls
TEMPERATURE=0
MAX_OUTPUT_TOKENS=1200
# Free local translation backend. The Hugging Face token is used only to
# download the gated model and is never written to dataset outputs.
HUGGINGFACE_TOKEN=PASTE_HUGGINGFACE_TOKEN_HERE
TRANSLATION_BACKEND=indictrans2
INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
# Ungated fallback when IndicTrans2 access has not yet been approved:
NLLB_MODEL=facebook/nllb-200-distilled-600M

